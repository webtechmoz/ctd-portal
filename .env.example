# Application
APP_ENV=local
APP_NAME=CTD Portal
APP_HOST=0.0.0.0
APP_PORT=8800
SECRET_KEY=change-me-to-a-long-random-string
JWT_TTL_HOURS=8
CORS_ORIGINS=http://localhost:8800
ALLOWED_EMAIL_DOMAIN=gapi.co.mz
AUTO_MIGRATE=true

# --- Local MySQL (campos separados; a app cria a DB se nao existir) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=ctd_portal
MYSQL_CHARSET=utf8mb4

# --- Producao Railway Postgres ---
# Nao preencher localmente. No Railway:
#   APP_ENV=production
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   SECRET_KEY=<string longa e aleatoria>
#   SEED_ADMIN_PASSWORD=<password forte>
#   SEED_SAMPLE_DATA=false
#   R2_* preenchidos
# O valor chega como postgresql://... (sem +psycopg); a app normaliza para
# postgresql+psycopg://... automaticamente.
# DATABASE_URL=

SEED_ADMIN_EMAIL=admin@gapi.co.mz
SEED_ADMIN_NAME=Administrador CTD
SEED_ADMIN_PASSWORD=Admin@CTD2026
# Projectos demo (meuCredito, DHIS2, …). Em producao e sempre ignorado.
# Avaliacoes nunca sao seed.
SEED_SAMPLE_DATA=true

# Resend
RESEND_API_KEY=
RESEND_FROM=CTD GAPI <noreply@gapi.co.mz>

# Cloudflare R2 (S3-compatible) — obrigatorio em producao
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ctd-portal

# Uploads locais (apenas quando R2 nao esta configurado — dev)
UPLOAD_DIR=uploads

# Python 3.13+ no Windows: se HTTPS falhar com
# "Basic Constraints of CA cert not marked critical", activa isto localmente.
# Em producao (Railway) deixar false.
SSL_RELAX_X509_STRICT=false
